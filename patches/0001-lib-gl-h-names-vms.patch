Subject: lib: on OpenVMS, include the generated *.gl.h headers as *_gl.h

VSI C cannot #include a file whose name has two dots (on ODS-5 the file is
scratch_buffer^.gl.h).  tools/prepare.sh renames the generated headers to
*_gl.h; include them by that name on VMS.  (As in vms-sed.)

--- a/lib/scratch_buffer.h	2026-10-04 07:44:01.108156007 +0100
+++ b/lib/scratch_buffer.h	2026-10-04 07:44:01.116217647 +0100
@@ -112,6 +112,12 @@
 # define _GL_UNLIKELY(cond) __builtin_expect ((cond), 0)
 #endif
 
-#include <malloc/scratch_buffer.gl.h>
+#ifdef __VMS
+/* VSI C cannot #include a file name with two dots; prepare.sh renames the
+   generated *.gl.h files to *_gl.h.  */
+# include <malloc/scratch_buffer_gl.h>
+#else
+# include <malloc/scratch_buffer.gl.h>
+#endif
 
 #endif /* _GL_SCRATCH_BUFFER_H */
