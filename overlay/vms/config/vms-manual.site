# Hand-settled configure answers for OpenVMS (VSI C, both IA64 and x86-64).
#
# Loaded after the VSI C configure answers, so values here win.  Use this for checks the
# VSI C configure run cannot answer: run-time behaviour tests (AC_RUN_IFELSE),
# compiler-feature tests, and anything it got wrong.  Give a reason
# for every entry.

# x86 CRTL has pthread_sigmask, IA64 does not.  wget is built without threads,
# so use sigprocmask on both for identical behaviour.
ac_cv_func_pthread_sigmask=no

# configure reads byte order out of an object file in cross mode, which
# vmscc does not return.  IA64 (as used by VMS) and x86-64 are little-endian.
ac_cv_c_bigendian=no

# The CRTL's <string.h> provides mempcpy as a function-like macro (no linkable
# symbol), so configure's link test says "no"; gnulib's replacement
# declaration then collides with the macro.  Use the CRTL macro.
ac_cv_func_mempcpy=yes
gl_cv_onwards_func_mempcpy=yes


# struct sched_param is in <pthread.h> on VMS (gnulib knows; patch 0004 makes
# configure ask for host "openvms").  The VSI C configure run predates that
# patch and never asked, so record the answer here.
ac_cv_type_struct_sched_param=yes

# gnulib's strcasecmp test is a run test with no cross-compiling answer.  It
# only tests anything in a fr_FR ISO-8859-1 locale (otherwise it keeps its
# guess, "yes" for all but Solaris and Cygwin); VSI's C RTL compares bytes
# with tolower() like any C library.
gl_cv_func_strcasecmp_works=yes

# OpenVMS Alpha (V8.4-2L2, VSI C V7.4-002): the staged config.h, generated from the IA64
# answers (configure-ia64.cache), is shared by all three architectures.  No full configure
# was run on the Alpha.  Instead every test program that the IA64 configure run sent to
# VSI C was compiled, linked or preprocessed on the node with the real compiler qualifiers
# and defines (ccflags.txt), as the compile server does, in one batch job.  The programs
# were collected by running configure on the host against the IA64 answer memo with a
# recording compiler stub (no node needed; it reproduced configure-ia64.cache exactly), so
# they are configure's own text with its confdefs.h.  376 distinct programs:
#   - 259 compile tests (136 ok, 123 fail): headers, declarations, types, members and the
#     compiler-feature tests behind ac_cv_c_*, gl_cv_c_* and gl_cv_header_*.
#   - 99 link tests (50 ok, 49 fail): the functions (ac_cv_func_*, gnulib's "onwards" and
#     gl_cv_func_* link checks), ac_cv_lib_* and ac_cv_search_*.
#   - 18 preprocess tests (15 ok, 3 fail).
# Result: all 376 give the same verdict on the Alpha as on the IA64 (0 differences).  For
# the 15 preprocess tests that produce output, 14 give the same text as the IA64 apart from
# the line markers; one (the PATH_MAX test) differs in two lines of the CRTL's <setjmp.h>
# (internal helper routines, LIB$GET_CURRENT_INVO_CONTEXT instead of decc$setjmp1, declared
# differently), which the test does not look at: the marker it searches for is present
# identically.  mempcpy, pthread_sigmask and struct sched_param are not among the programs:
# they are settled above, for all architectures.  So the one config.h serves IA64, x86-64
# and Alpha.
# A short run-time probe (linked with the same qualifiers) agrees with the cached run-time
# answers: long, pointers, size_t, ptrdiff_t, time_t, wchar_t, wint_t and sig_atomic_t are
# 32 bits, off_t 64; size_t, wchar_t and time_t unsigned, ptrdiff_t, wint_t and
# sig_atomic_t signed; little-endian; realloc(p,0) returns NULL; open() of a directory
# fails with ENOENT (gl_cv_func_open_directory_works=no); stat() of "file/" fails; mktime()
# of 1970-01-01 gives -1.  Where the Alpha is better than the cross run's guess
# ("guessing no": malloc(0) returns non-NULL, getcwd(NULL,0) works), gnulib then uses its
# own replacement, which is also what the IA64 and x86-64 builds use; the replacements
# work on every architecture.
